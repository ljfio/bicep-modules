{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "devPolicy": {
      "value": {
        "isProduction": false,
        "haRequired": false,
        "replicas": 1,
        "extra": {}
      }
    },
    "testPolicy": {
      "value": {
        "isProduction": false,
        "haRequired": false,
        "replicas": 1,
        "extra": {}
      }
    },
    "uatPolicy": {
      "value": {
        "isProduction": false,
        "haRequired": true,
        "replicas": 2,
        "extra": {}
      }
    },
    "stagePolicy": {
      "value": {
        "isProduction": true,
        "haRequired": true,
        "replicas": 2,
        "extra": {}
      }
    },
    "prodPolicy": {
      "value": {
        "isProduction": true,
        "haRequired": true,
        "replicas": 3,
        "extra": {
          "zoneRedundant": true
        }
      }
    },
    "demoPolicy": {
      "value": {
        "isProduction": false,
        "haRequired": false,
        "replicas": 1,
        "extra": {}
      }
    },
    "devReplicas": {
      "value": 1
    },
    "uatReplicas": {
      "value": 2
    },
    "prodReplicas": {
      "value": 3
    },
    "devIsProduction": {
      "value": false
    },
    "testIsProduction": {
      "value": false
    },
    "uatIsProduction": {
      "value": false
    },
    "stageIsProduction": {
      "value": true
    },
    "prodIsProduction": {
      "value": true
    },
    "demoIsProduction": {
      "value": false
    },
    "overrideWins": {
      "value": {
        "isProduction": true,
        "haRequired": true,
        "replicas": 5,
        "extra": {
          "zoneRedundant": true
        }
      }
    },
    "overrideReplicas": {
      "value": 5
    },
    "extraDeepMerge": {
      "value": {
        "zoneRedundant": true,
        "telemetry": "full"
      }
    },
    "overrideNewKey": {
      "value": {
        "isProduction": false,
        "haRequired": false,
        "replicas": 1,
        "extra": {},
        "retireAfterDays": 30
      }
    },
    "nullOverrideDropped": {
      "value": 1
    }
  }
}